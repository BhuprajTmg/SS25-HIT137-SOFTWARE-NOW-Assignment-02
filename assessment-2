
import turtle
import math


def draw_edge(length, depth):
    # base case ensures recursion stops and prevents infinite function calls
    if depth == 0:
        turtle.forward(length)
    else:
        # reducing the segment size allows the pattern to become more detailed at each level
        length = length / 3
        
        # recursively apply the same pattern to each new segment
        draw_edge(length, depth - 1)
        # angled turns create the inward equilateral triangle indentation
        turtle.right(60)
        draw_edge(length, depth - 1)
        turtle.left(120)
        draw_edge(length, depth - 1)
        turtle.right(60)
        draw_edge(length, depth - 1)


# Fixed indentation: moved this function outside of draw_edge
def draw_polygon(sides, length, depth):
    # the exterior angle ensures the turtle completes a closed regular polygon
    angle = 360 / sides
    # applying the recursive edge transformation to every side builds the full pattern
    for _ in range(sides):
        draw_edge(length, depth)
        turtle.left(angle)


# setting high speed avoids long wait times for deep recursion
turtle.speed(0)
turtle.shape("turtle")

# user input allows experimentation with different shapes and recursion levels
sides = int(input("enter the number of sides: "))
length = int(input("enter the side length: "))
depth = int(input("enter the recursion depth: "))

# centering the drawing improves visibility regardless of polygon size
turtle.penup()
turtle.goto(-length / 2, length / 2)
turtle.pendown()
draw_polygon(sides, length, depth)
turtle.done()
